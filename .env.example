# Envio do formulario de contato (design.md §9.7 / src/app/actions/contato.ts)
# Sem esta chave o formulario valida tudo mas nao envia: ele mostra um erro
# pedindo para escrever direto no e-mail. Crie a chave em https://resend.com
RESEND_API_KEY=

# Remetente. Enquanto o dominio nao estiver verificado na Resend, deixe em branco
# (o padrao "onboarding@resend.dev" funciona). Depois: "Portfolio <contato@hugootoch.dev>"
CONTATO_FROM=

# Muro de depoimentos (src/lib/convite.ts). Chave que assina os links de convite:
# sem ela nenhum convite vale. Gere uma longa e aleatoria, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar a chave invalida todos os convites ja enviados.
DEPOIMENTO_SEGREDO=

# Endereco usado nos links gerados por `npm run convite` (padrao: https://hugootoch.dev).
# Para testar localmente: http://localhost:3000
SITE_URL=
